{
  "meta": {
    "name": "Ledge design tokens",
    "version": "2.0 (Ink and Bone)",
    "source": "docs/spec.md section 2.2, ADHD-first refinement of the SnappyNotes palette"
  },
  "light": {
    "bg": "#F3F1EB",
    "surface": "#FFFFFF",
    "surface2": "#EDEBE6",
    "text": "#0B0C0D",
    "textMuted": "#6D6774",
    "textAged": "#9B95A1",
    "border": "#E2E0DA",
    "accent": "#99612F",
    "accentHover": "#7D4F26",
    "done": "#307A64",
    "attention": "#695725",
    "selectionAlpha": 0.18
  },
  "dark": {
    "bg": "#0B0C0D",
    "surface": "#171614",
    "surface2": "#201E1B",
    "text": "#F3F1EB",
    "textMuted": "#C4C6CA",
    "textAged": "#8E8F94",
    "border": "#292826",
    "accent": "#B17E51",
    "accentHover": "#C89A73",
    "done": "#4FC4A6",
    "attention": "#E0B93A",
    "selectionAlpha": 0.24
  },
  "type": {
    "editorBody": 15,
    "editorLineHeightMultiple": 1.6,
    "h1": 22,
    "h2": 18,
    "h3": 15,
    "code": 13,
    "meta": 11
  },
  "layout": {
    "grid": 4,
    "panelWidthDefault": 380,
    "panelWidthMin": 320,
    "panelWidthMax": 520,
    "contentPadding": 20,
    "dayGroupSpacing": 24,
    "radiusPanel": 12,
    "radiusControl": 6
  },
  "motion": {
    "slideMs": 160,
    "reduceMotionFallbackMs": 100
  },
  "rules": [
    "one primary action per view",
    "no red states anywhere; attention is amber, in-surface, sentence case",
    "no badges, counts, streaks, or overdue markers",
    "age fades content toward textAged, never flags it"
  ]
}
