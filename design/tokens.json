{
  "meta": {
    "name": "Ledge design tokens",
    "version": "1.1",
    "source": "docs/spec.md section 2.2, ADHD-first refinement of the SnappyNotes palette"
  },
  "light": {
    "bg": "#F7F5F2",
    "surface": "#FCFBF8",
    "surface2": "#F0ECE5",
    "text": "#1C1B1D",
    "textMuted": "#6D6774",
    "textAged": "#9B95A1",
    "border": "#E3DDE1",
    "accent": "#BD4753",
    "accentHover": "#A33843",
    "done": "#367B23",
    "attention": "#C28A0F",
    "selectionAlpha": 0.18
  },
  "dark": {
    "bg": "#1C1B1D",
    "surface": "#28272A",
    "surface2": "#211F23",
    "text": "#F7F5F2",
    "textMuted": "#C4C6CA",
    "textAged": "#8E8F94",
    "border": "#383638",
    "accent": "#E78892",
    "accentHover": "#EFA9B0",
    "done": "#A0D392",
    "attention": "#E8B13B",
    "selectionAlpha": 0.24
  },
  "type": {
    "editorBody": 15,
    "editorLineHeightMultiple": 1.6,
    "h1": 22,
    "h2": 18,
    "h3": 15,
    "code": 13,
    "meta": 11
  },
  "layout": {
    "grid": 4,
    "panelWidthDefault": 380,
    "panelWidthMin": 320,
    "panelWidthMax": 520,
    "contentPadding": 20,
    "dayGroupSpacing": 24,
    "radiusPanel": 12,
    "radiusControl": 6
  },
  "motion": {
    "slideMs": 160,
    "reduceMotionFallbackMs": 100
  },
  "rules": [
    "one primary action per view",
    "no red states anywhere; attention is amber, in-surface, sentence case",
    "no badges, counts, streaks, or overdue markers",
    "age fades content toward textAged, never flags it"
  ]
}
